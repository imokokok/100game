# Copy to .env.local for local development, or configure as Vercel/Supabase
# environment variables in production. Never commit real values.

# Supabase Postgres connection string (use the pooler URL, port 6543, for
# serverless deployments). Format:
# postgresql://postgres.xxxx:[PASSWORD]@aws-0-xxxx.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Vercel Blob read/write token (auto-injected by Vercel when Blob is linked).
BLOB_READ_WRITE_TOKEN=

# Application secrets.
LEAD_ACCESS_CODE=replace-with-a-private-lead-code
LEAD_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Read-only access to NPC questionnaire results. The session falls back to
# LEAD_SESSION_SECRET when SURVEY_RESULTS_SESSION_SECRET is not set.
SURVEY_RESULTS_ACCESS_CODE=100
SURVEY_RESULTS_SESSION_SECRET=
